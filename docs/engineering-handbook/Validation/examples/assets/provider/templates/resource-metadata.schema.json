{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/echoes-demo-metadata/0.1.0",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "identifier",
    "title",
    "description",
    "provider",
    "contact",
    "license",
    "version",
    "modified",
    "accessConditions"
  ],
  "properties": {
    "@context": {
      "type": "object"
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string"
    },
    "modified": {
      "type": "string",
      "format": "date"
    },
    "accessConditions": {
      "enum": [
        "public",
        "restricted",
        "internal"
      ]
    },
    "contact": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    }
  }
}
